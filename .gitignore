# Python cache
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd

# Logs
*.log
backend.log
backend/backend.log

# PID files
*.pid
backend/backend.pid

# Environment files (secrets — never commit)
backend/.env

# Backup files (should never enter Git)
**/*.bak
**/*.backup
**/*.backup_*
**/*.before_*
**/*.after_*
**/*.emergency_backup
**/*_debug.js
**/*.broken_backup*

# Temporary/empty legacy files
frontend/src/views/HomeV1.vue

# Virtual environment
venv/
.venv/
